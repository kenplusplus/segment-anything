# SPDX-License-Identifier: Apache-2.0
#
# SAM 2 with TensorRT support
#
# Build:
#   docker build -f Dockerfile.tensorrt -t sam2-trt .
#
# Run:
#   docker run --gpus all --rm -v $(pwd)/datasets:/workspace/datasets \
#       sam2-trt python scripts/amg.py \
#           --checkpoint /workspace/models/sam_vit_b_01ec64.pth \
#           --model-type vit_b \
#           --input /workspace/datasets/sa_8382.jpg \
#           --output /workspace/output \
#           --use-trt --trt-engine /workspace/sam_vit_b_decoder.engine \
#           --points-per-side 8 --points-per-batch 8 --crop-n-layers 0

FROM nvcr.io/nvidia/tensorrt:24.09-py3

RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 libsm6 libxext6 libxrender-dev tmux && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir torch==2.4.0 torchvision==0.19.0 torchaudio==2.4.0 --index-url https://download.pytorch.org/whl/cu121

COPY . /workspace/segment_anything/

RUN pip install --no-cache-dir -e /workspace/segment_anything && pip install --no-cache-dir opencv-python pycocotools matplotlib onnxruntime-gpu onnx numpy

ENV PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
ENV LD_LIBRARY_PATH=/usr/local/tensorrt/lib:${LD_LIBRARY_PATH}
ENV PYTHONPATH=/workspace/segment_anything/:${PYTHONPATH}

WORKDIR /workspace

CMD ["/workspace/segment_anything/start_test.sh"]
